<Window x:Class="TNovUtilsAR.CopyWindowsWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovUtilsAR"
        mc:Ignorable="d"
        Width="680"
        Height="520"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ПРОЕМЩИК"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="Отмеченные элементы будут скопированы (старые удалены)"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,10"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">
                <TextBlock Text="Показать:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="CategoryFilterCombo"
                          Width="140"
                          Style="{StaticResource DarkComboBoxStyle}"
                          SelectionChanged="CategoryFilter_Changed">
                    <ComboBoxItem IsSelected="True">Все</ComboBoxItem>
                    <ComboBoxItem>Окна</ComboBoxItem>
                    <ComboBoxItem>Двери</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <DataGrid Grid.Row="3"
                      x:Name="ItemsDataGrid"
                      Style="{StaticResource DarkDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Выбрать" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource TreeCheckToggleStyle}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Категория"
                                        Binding="{Binding Category}"
                                        Width="120"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="Тип"
                                        Binding="{Binding TypeName}"
                                        Width="*"
                                        MinWidth="160"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="Высота (мм)"
                                        Binding="{Binding HeightMm, StringFormat={}{0:F0}}"
                                        Width="100"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="Ширина (мм)"
                                        Binding="{Binding WidthMm, StringFormat={}{0:F0}}"
                                        Width="100"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Глубина проема (мм):"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="DepthTextBox"
                             Width="100"
                             Height="36"
                             Text="500"
                             Style="{StaticResource DarkTextBoxStyle}"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="Закрыть"
                            x:Name="escButton"
                            MinWidth="90"
                            Padding="10,6"
                            Margin="0,0,6,0"
                            Click="escButton_Click"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="Выбрать все"
                            MinWidth="90"
                            Padding="10,6"
                            Margin="0,0,6,0"
                            Click="SelectAll_Click"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="Снять все"
                            MinWidth="90"
                            Padding="10,6"
                            Margin="0,0,6,0"
                            Click="DeselectAll_Click"/>
                    <Button Style="{StaticResource RunButtonStyle}"
                            Content="Создать"
                            MinWidth="90"
                            Padding="10,6"
                            Margin="0"
                            Click="Create_Click"/>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
