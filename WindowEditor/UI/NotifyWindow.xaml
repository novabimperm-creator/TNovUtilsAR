<Window x:Class="WindowEditor.UI.NotifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <Grid Margin="18,12,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="Transparent" MouseLeftButtonDown="Title_MouseDown" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Content="✕" Style="{StaticResource CloseButtonStyleMini}" Height="29"
                            Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource InfoCardBorderStyle}" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                    <TextBox x:Name="MessageText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" Padding="0"/>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" x:Name="Buttons"/>
        </Grid>
    </Border>
</Window>
