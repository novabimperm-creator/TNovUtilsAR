<Window x:Class="WindowEditor.UI.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор окна" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- поля и списки — компактные варианты стилей TNov -->
            <Style TargetType="TextBox" BasedOn="{StaticResource DarkCompactTextBoxStyle}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <ControlTemplate x:Key="WeComboToggle" TargetType="ToggleButton">
                <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <TextBlock Text="▾" Foreground="{TemplateBinding Foreground}" FontSize="12" Margin="0,0,9,0"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TreeToggleBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                                              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                              Template="{StaticResource WeComboToggle}"/>
                                <ContentPresenter x:Name="contentPresenter" Margin="10,0,26,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                <TextBox x:Name="PART_EditableTextBox" Margin="4,0,24,0" VerticalAlignment="Center"
                                         Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0"
                                         Height="Auto" MinHeight="0" Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{TemplateBinding Foreground}" Style="{x:Null}"/>
                                <Popup x:Name="popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="3"
                                            BorderBrush="{StaticResource SelectedBrush}" BorderThickness="1"
                                            MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="contentPresenter" Property="Visibility" Value="Hidden"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBoxStyle}">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="box" Width="17" Height="17" CornerRadius="5" VerticalAlignment="Center"
                                        Background="{StaticResource CardBrush}" BorderBrush="{StaticResource TreeToggleBorderBrush}" BorderThickness="1.5">
                                    <TextBlock x:Name="check" Text="✓" FontSize="11" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="box" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                    <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource SelectedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- тонкая полоса прокрутки в цветах темы -->
            <Style x:Key="WeThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border CornerRadius="3" Background="{StaticResource TreeToggleBorderBrush}" Opacity="0.6"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="6"/>
                <Setter Property="MinWidth" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb><Thumb Style="{StaticResource WeThumb}"/></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb><Thumb Style="{StaticResource WeThumb}"/></Track.Thumb>
                                    </Track>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TextBlock" x:Key="Hdr">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Margin" Value="0,12,0,6"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="Lbl">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="Margin" Value="0,0,8,6"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="Muted">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- вкладки-«пилюли» -->
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="pill" CornerRadius="8" Padding="9,6" Margin="0,0,3,0" Background="Transparent">
                                <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="pill" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="pill" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TabControl">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="3" Margin="0,0,0,8">
                                    <WrapPanel IsItemsHost="True"/>
                                </Border>
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- плитка шаблона на вкладке «Старт» -->
            <Style x:Key="PresetTile" TargetType="Button">
                <Setter Property="Width" Value="116"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="tile" CornerRadius="10" Padding="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <Grid Margin="16,12,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="392"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- заголовок -->
            <Border Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="РЕДАКТОР ОКНА" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="TitleInfo" Foreground="{StaticResource MutedBrush}" FontSize="13"
                               VerticalAlignment="Center" Margin="14,3,8,0" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Content="✕" Style="{StaticResource CloseButtonStyleMini}" Height="29"
                            Click="Cancel_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Закрыть без изменений"/>
                </Grid>
            </Border>

            <!-- холст -->
            <Border Grid.Column="0" Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="2" Margin="0,0,14,0">
                <Canvas x:Name="Sheet" ClipToBounds="True" Background="Transparent" Focusable="True"
                        MouseLeftButtonDown="Sheet_MouseDown" MouseMove="Sheet_MouseMove"
                        MouseLeftButtonUp="Sheet_MouseUp" SizeChanged="Sheet_SizeChanged"/>
            </Border>
            <TextBlock Grid.Column="0" Grid.Row="2" Style="{StaticResource Muted}" Margin="2,8,14,0" VerticalAlignment="Center"
                       Text="Вид с фасада. Клик — поле, створка (по её профилю), импост или рама секции. Тянуть импост — шаг 5 мм. V / H — импост рамы, Shift+V / Shift+H — импост в створке, Del — удалить, Ctrl+Z — отмена. Цифры в кружках — номера стёкол."/>

            <!-- панель справа -->
            <TabControl Grid.Column="1" Grid.Row="1" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

                <TabItem Header="Старт" x:Name="StartTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel x:Name="StartPanel"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Схема" x:Name="SchemeTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hdr}" Margin="0,2,0,6" Text="Семейство"/>
                            <TextBox x:Name="FamilyNameBox" TextChanged="FamilyNameBox_TextChanged"/>
                            <CheckBox x:Name="SaveAsNewBox" Content="Сохранить как новое семейство"/>
                            <CheckBox x:Name="EmptyBox" Content="Пустой проём (без рамы)" Click="EmptyBox_Click"
                                      ToolTip="Без рамы, створок и стёкол. Откосы, подоконные доски и отливы включаются на вкладке «Комплектация»."/>
                            <UniformGrid Columns="2">
                                <Button Content="Имя по схеме" Click="NameByCode_Click" Margin="0,0,3,6"
                                        ToolTip="Код: ряды снизу вверх, в каждом — число створок и глухих полей, у которых там низ"/>
                                <Button Content="⇋ Отразить Л/П" Click="Mirror_Click" Margin="3,0,0,6"
                                        ToolTip="Зеркальный вариант: порядок ячеек, стороны петель, откосы, имя Левое ↔ Правое"/>
                            </UniformGrid>

                            <TextBlock Style="{StaticResource Hdr}" x:Name="SectionHeader" Text="Секция"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SecWidthLabel" Style="{StaticResource Muted}" Margin="0,0,0,2" Text="Ширина рамы"/>
                                    <TextBox x:Name="SecWidthBox" LostFocus="Section_Commit" KeyDown="Box_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="SecHeightLabel" Style="{StaticResource Muted}" Margin="0,0,0,2" Text="Высота рамы"/>
                                    <TextBox x:Name="SecHeightBox" LostFocus="Section_Commit" KeyDown="Box_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,2" Text="Низ проёма над низшим" ToolTip="Для окна рядом с балконной дверью — высота подоконной части стены"/>
                                    <TextBox x:Name="SecRaiseBox" LostFocus="Section_Commit" KeyDown="Box_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,2" Text="Зазор снизу"/>
                                    <TextBox x:Name="SecGapBottomBox" LostFocus="Section_Commit" KeyDown="Box_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,2" Text="Зазор над стеной" ToolTip="Под частью рамы, стоящей на подоконной части стены (ячейка «Стена»)"/>
                                    <TextBox x:Name="SecGapStepBox" LostFocus="Section_Commit" KeyDown="Box_KeyDown"/>
                                </StackPanel>
                            </Grid>
                            <UniformGrid Columns="2">
                                <Button Content="+ Секция справа" Click="AddSection_Click" Margin="0,0,3,6"/>
                                <Button x:Name="RemoveSectionBtn" Content="Удалить секцию" Click="RemoveSection_Click" Margin="3,0,0,6"/>
                            </UniformGrid>

                            <StackPanel x:Name="ImpostPanel">
                                <TextBlock Style="{StaticResource Hdr}" Text="Импосты"/>
                                <UniformGrid Columns="2">
                                    <Button Content="│ Вертикальный (V)" Click="AddV_Click" Margin="0,0,3,6"/>
                                    <Button Content="─ Горизонтальный (H)" Click="AddH_Click" Margin="3,0,0,6"/>
                                    <Button Content="│ В створке (Shift+V)" Click="AddSashV_Click" Margin="0,0,3,6"
                                            ToolTip="Импост внутри створки: створка остаётся одна, делится заполнение"/>
                                    <Button Content="─ В створке (Shift+H)" Click="AddSashH_Click" Margin="3,0,0,6"
                                            ToolTip="Например, дверь: стекло сверху, панель снизу"/>
                                </UniformGrid>
                                <Button x:Name="RemoveBtn" Content="Удалить импост (Del)" Click="Remove_Click"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Hdr}" x:Name="SelHeader" Text="Выделение"/>
                            <StackPanel x:Name="LeafPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,2" Text="Заполнение"/>
                                <ComboBox x:Name="FillBox" SelectionChanged="FillBox_SelectionChanged"/>
                                <TextBlock x:Name="InfillLabel" Style="{StaticResource Muted}" Margin="0,0,0,2" Text="Заполнение поля"/>
                                <ComboBox x:Name="InfillBox" SelectionChanged="InfillBox_SelectionChanged">
                                    <ComboBoxItem Content="Стекло (стеклопакет)"/>
                                    <ComboBoxItem Content="Панель (глухая, непрозрачная)"/>
                                </ComboBox>
                                <TextBlock x:Name="GlassLabel" Style="{StaticResource Muted}" Margin="0,0,0,2" Text="Материал стекла"/>
                                <ComboBox x:Name="GlassMatBox" IsEditable="True" LostFocus="GlassMat_Commit" SelectionChanged="GlassMat_Changed"/>
                                <TextBlock x:Name="LeafSizeText" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel x:Name="MullionPanel" Visibility="Collapsed">
                                <TextBlock x:Name="MullionAxisLabel" Style="{StaticResource Muted}" Margin="0,0,0,2" Text="Ось импоста, мм"/>
                                <TextBox x:Name="MullionAxisBox" LostFocus="MullionAxis_Commit" KeyDown="Box_KeyDown"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Hdr}" Text="Итоги"/>
                            <Border Style="{StaticResource InfoCardBorderStyle}" Margin="0,0,0,4">
                                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" LineHeight="19"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Проём" x:Name="OpeningTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <Grid x:Name="OpeningGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Комплектация" x:Name="KitTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel x:Name="KitPanel"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Материалы" x:Name="MatTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel x:Name="MatPanel"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Отмена" Width="110" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" Style="{StaticResource CloseButtonStyle}"/>
                <Button Content="Применить в Revit" Width="170" Margin="0" Click="Ok_Click" Style="{StaticResource RunButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
