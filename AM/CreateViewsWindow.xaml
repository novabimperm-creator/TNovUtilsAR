<Window x:Class="TNovUtilsAR.CreateViewsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AM_PSO — Создание видов квартир"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <StackPanel Margin="18">
            <Border MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СОЗДАНИЕ ВИДОВ КВАРТИР"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            IsHitTestVisible="False"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="OnCloseClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Источник комнат"
                           Grid.Row="0" Grid.Column="0"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,6"/>
                <ComboBox x:Name="SourceComboBox"
                          Grid.Row="0" Grid.Column="1"
                          Margin="0,6"
                          Style="{StaticResource DarkComboBoxStyle}"
                          DisplayMemberPath="DisplayName"/>

                <TextBlock Text="Уровень"
                           Grid.Row="1" Grid.Column="0"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,6"/>
                <ComboBox x:Name="LevelComboBox"
                          Grid.Row="1" Grid.Column="1"
                          Margin="0,6"
                          Style="{StaticResource DarkComboBoxStyle}"
                          DisplayMemberPath="Name"/>

                <TextBlock Text="Номер этажа (для имени)"
                           Grid.Row="2" Grid.Column="0"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,6"/>
                <TextBox x:Name="FloorTextBox"
                         Grid.Row="2" Grid.Column="1"
                         Margin="0,6"
                         Height="36"
                         Style="{StaticResource DarkTextBoxStyle}"/>

                <TextBlock Text="Набор АМ"
                           Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"
                           Margin="0,10,0,2"/>

                <TextBlock Text="Шаблон общего вида этажа"
                           Grid.Row="4" Grid.Column="0"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,6"/>
                <ComboBox x:Name="GeneralTemplateComboBox"
                          Grid.Row="4" Grid.Column="1"
                          Margin="0,6"
                          Style="{StaticResource DarkComboBoxStyle}"
                          DisplayMemberPath="Name"/>

                <TextBlock Text="Шаблон ПК (план квартиры)"
                           Grid.Row="5" Grid.Column="0"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,6"/>
                <ComboBox x:Name="PkTemplateComboBox"
                          Grid.Row="5" Grid.Column="1"
                          Margin="0,6"
                          Style="{StaticResource DarkComboBoxStyle}"
                          DisplayMemberPath="Name"/>

                <TextBlock Text="Шаблон ПС, серия (выбрать …-1)"
                           Grid.Row="6" Grid.Column="0"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,6"/>
                <ComboBox x:Name="PsTemplateComboBox"
                          Grid.Row="6" Grid.Column="1"
                          Margin="0,6"
                          Style="{StaticResource DarkComboBoxStyle}"
                          DisplayMemberPath="Name"/>

                <TextBlock Text="Набор ПСО"
                           Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"
                           Margin="0,10,0,2"/>

                <TextBlock Text="Шаблон общего вида этажа"
                           Grid.Row="8" Grid.Column="0"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,6"/>
                <ComboBox x:Name="PsoGeneralTemplateComboBox"
                          Grid.Row="8" Grid.Column="1"
                          Margin="0,6"
                          Style="{StaticResource DarkComboBoxStyle}"
                          DisplayMemberPath="Name"/>

                <TextBlock Text="Шаблон ПК (план квартиры)"
                           Grid.Row="9" Grid.Column="0"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,6"/>
                <ComboBox x:Name="PsoPkTemplateComboBox"
                          Grid.Row="9" Grid.Column="1"
                          Margin="0,6"
                          Style="{StaticResource DarkComboBoxStyle}"
                          DisplayMemberPath="Name"/>

                <TextBlock Text="Шаблон ПС, серия (выбрать …-1)"
                           Grid.Row="10" Grid.Column="0"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,6"/>
                <ComboBox x:Name="PsoPsTemplateComboBox"
                          Grid.Row="10" Grid.Column="1"
                          Margin="0,6"
                          Style="{StaticResource DarkComboBoxStyle}"
                          DisplayMemberPath="Name"/>

                <StackPanel Orientation="Horizontal"
                            Grid.Row="11" Grid.Column="1"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Content="Отмена"
                            Style="{StaticResource CloseButtonStyle}"
                            MinWidth="100"
                            Margin="0,0,8,0"
                            IsCancel="True"/>
                    <Button Content="Создать"
                            Style="{StaticResource RunButtonStyle}"
                            MinWidth="100"
                            Margin="0"
                            IsDefault="True"
                            Click="OnCreateClick"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
