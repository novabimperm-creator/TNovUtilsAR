<Window x:Class="TNovUtilsAR.PluginPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторазмеры"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
          ResizeBorderThickness="5"
          GlassFrameThickness="0"
          CornerRadius="12"/>
    </WindowChrome.WindowChrome>
    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <StackPanel Margin="18">
            <Border MouseDown="TitleBar_MouseDown" Background="Transparent" Cursor="Arrow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ОФОРМЛЯТОР" Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i" Grid.Column="1" HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕" Grid.Column="2" HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>
            <TextBlock Text="Выберите функции и нажмите «Оформить»"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   Margin="0,2,0,16"/>

            <ToggleButton x:Name="AutoDimToggle" Style="{StaticResource CardToggleStyle}">
                <StackPanel>
                    <TextBlock Text="Авторазмеры" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="Оси, общий размер, цепочки проёмов по фасадам"
                           Style="{StaticResource CardSubtitleStyle}"/>
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="RoomTagsToggle" Style="{StaticResource CardToggleStyle}">
                <StackPanel>
                    <TextBlock Text="Метки помещений" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="Имя и площадь; лоджии — с коэффициентом"
                           Style="{StaticResource CardSubtitleStyle}"/>
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="MopTagsToggle" Style="{StaticResource CardToggleStyle}">
                <StackPanel>
                    <TextBlock Text="Марки МОП" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="Номер в круге для МОП и технических"
                           Style="{StaticResource CardSubtitleStyle}"/>
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="ApartmentTagsToggle" Style="{StaticResource CardToggleStyle}">
                <StackPanel>
                    <TextBlock Text="Марки квартир" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="Одна на квартиру/офис, вынос за оси, выноски"
                           Style="{StaticResource CardSubtitleStyle}"/>
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="WindowTagsToggle" Style="{StaticResource CardToggleStyle}">
                <StackPanel>
                    <TextBlock Text="Марки окон" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="Окна «Ок-…» и витражи, зазор 700 мм, поворот по стене"
                           Style="{StaticResource CardSubtitleStyle}"/>
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="DoorTagsToggle" Style="{StaticResource CardToggleStyle}">
                <StackPanel>
                    <TextBlock Text="Марки дверей" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="По центру двери, без дверных проёмов"
                           Style="{StaticResource CardSubtitleStyle}"/>
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="WindowViewsToggle" Style="{StaticResource CardToggleStyle}">
                <StackPanel>
                    <TextBlock Text="Виды окон" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="Фасад на каждую маркировку «Ок-…», шаблон и обрезка"
                           Style="{StaticResource CardSubtitleStyle}"/>
                    <CheckBox x:Name="WindowViewsDecorate" IsChecked="True" Margin="0,7,0,0">
                        <TextBlock Text="Оформлять виды (область, разрезы, размеры)"
                               Style="{StaticResource CardSubtitleStyle}" Margin="0"/>
                    </CheckBox>
                </StackPanel>
            </ToggleButton>

            <Button Content="Оформить"
                Style="{StaticResource RunButtonStyle}"
                Click="acceptButton_Click"/>
            <Button Content="Закрыть"
                Style="{StaticResource CloseButtonStyle}"
                Click="escButton_Click"/>
        </StackPanel>
    </Border>
</Window>
