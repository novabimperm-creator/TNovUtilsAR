<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{88730ED1-7018-4A9A-A770-10E8084C653A}</ProjectGuid>
    <RootNamespace>TNovUtilsAR</RootNamespace>
    <AssemblyName>TNovUtilsAR</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TNovCommon\TNovCommon.csproj" Private="false" />
  </ItemGroup>

  <!-- Самодостаточный проект «Авторазмеры» (своя лента + WPF-панель, namespace
       TNovUtilsAR) лежит в репозитории отдельным проектом и НЕ компилируется
       в составе TNovUtilsAR (у него свой Logger/WPF и другой namespace). -->
  <ItemGroup>
    <Compile Remove="Авторазмеры\**\*.cs" />
  </ItemGroup>

  <!-- Редактор окон (WindowEditor/, namespace WindowEditor), перенесён из отдельной
       надстройки; его #if REVIT2024_OR_GREATER (ElementId.Value) включаем для R2027.
       Кнопки ленты — в TNov/Application.cs (своё App.cs не переносилось). -->
  <PropertyGroup Condition="'$(Configuration)' == 'R2027'">
    <DefineConstants>$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- ===== Версионирование ===== -->
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(ProjectDir)UpdateVersion.ps1&quot;" />
  </Target>

</Project>
